# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mnemos_secret

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mnemos_memories

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "openai" | "deepseek"
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek alternative (cheaper for fact extraction)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Sentence transformer model (runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ─── Memory Decay Engine ──────────────────────────────────────────────────────
# How often to run the decay sweep (hours)
DECAY_INTERVAL_HOURS=6

# Edge weight below this threshold gets archived
DECAY_THRESHOLD=0.05

# Base stability factor for Ebbinghaus curve (higher = slower forgetting)
DECAY_STABILITY_BASE=24.0

# Multiplier applied when memory is resurrected via reinforcement
DECAY_RESURRECTION_BOOST=2.0

# ─── Contradiction Resolution ─────────────────────────────────────────────────
# Cosine similarity threshold to consider two facts potentially conflicting
CONTRADICTION_SIMILARITY_THRESHOLD=0.85

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Shared secret for inter-service auth (optional)
MNEMOS_API_SECRET=change_me_in_production

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
